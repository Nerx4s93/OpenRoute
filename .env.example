# Секрет internal API: им admin-service ходит в шлюз (/internal/*).
# ДОЛЖЕН совпадать с INTERNAL_API_TOKEN в admin-service/.env.
# Пусто = internal API выключен (404).
INTERNAL_API_TOKEN=

# Хост-порт edge (docker-compose). NVRoute публикует свой edge на 53201,
# поэтому по умолчанию OpenRoute занимает 53202 — оба стека работают вместе.
OPENROUTE_EDGE_PORT=53202

POSTGRES_DSN=postgresql://openroute:openroute@postgres:5432/openroute  # PostgreSQL (сервис postgres в сети openroute-net): лог запросов + таблицы proxies/keys; в Docker перекрывается docker-compose
PROXIES_URL=http://openroute-proxy6:8000/proxies  # контейнер openroute-proxy6 (в docker-сети openroute-net)
PROXY_REFRESH_SECONDS=300                       # период перечитывания списка прокси
PROXY_RETRY_SECONDS=10                          # ретрай после неудачного фетча прокси

OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1   # chat/completions апстрим (free-tier)
OPENCODE_MODELS_URL=https://opencode.ai/inference/v1/models # каталог моделей (health-probe прокси)
OPENCODE_MODEL=deepseek-v4.1-flash-free                     # модель по умолчанию (free-tier)
OPENROUTE_RPM_LIMIT=0                           # локальный кап запросов/мин на прокси (0 = выключен; free-tier лимитируется по IP/суткам, не по RPM)

UPSTREAM_TIMEOUT=300                            # общий таймаут апстрима, сек
CONNECT_TIMEOUT=10                              # connect-таймаут отдельно от read, сек

PROXY_COOLDOWN_DEFAULT_SECONDS=60               # cooldown на 429 без Retry-After (mirror RPM_WINDOW_SECONDS)
ACCOUNT_FAIL_THRESHOLD=3                        # ошибок в окне до cooldown
ACCOUNT_FAIL_WINDOW_SECONDS=60                   # rolling window ошибок, сек
ACCOUNT_COOLDOWN_SECONDS=60                     # базовый cooldown, сек
ACCOUNT_COOLDOWN_MAX_SECONDS=600                # потолок экспоненциального роста cooldown, сек
ACCOUNT_THROTTLE_THRESHOLD=3                    # подряд 429-кулдаунов до парковки (успех сбрасывает счётчик)
ACCOUNT_THROTTLE_COOLDOWN_SECONDS=3600          # парковка затроттлированного прокси, сек
HEALTH_CHECK_TIMEOUT=8                          # таймаут probe прокси, сек
RETRY_BUDGET_SECONDS=90                         # общий бюджет ретраев на запрос, сек
RETRY_BACKOFF_BASE_SECONDS=0.5                  # база экспоненциального backoff, сек
MAX_BODY_BYTES=20971520                         # лимит тела запроса (20 МиБ), байт
ALERT_WEBHOOK_URL=                              # webhook алертов (Slack-совместимый {"text": ...}); пусто = выключено
