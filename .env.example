# Секрет internal API: им web-admin ходит в шлюз (/internal/*).
# ДОЛЖЕН совпадать с INTERNAL_API_TOKEN в web-admin/.env.
# Пусто = internal API выключен (404).
INTERNAL_API_TOKEN=

# Хост-порт edge (docker-compose). NVRoute публикует свой edge на 53201,
# поэтому по умолчанию OpenRoute занимает 53202 — оба стека работают вместе.
OPENROUTE_EDGE_PORT=53202

# storage-service — единственный компонент, который ходит в PostgreSQL.
# Gateway DSN не знает: ВСЁ хранилище (прокси, клиентские ключи, affinity,
# personas, лог запросов и статистика) доступно только по HTTP через этот
# сервис. DSN задаётся в storage-service/.env (+ переопределяется в compose).
# Токена нет: сервис доступен только gateway в приватной сети
# openroute-storage-api-net и аутентификацию не требует.
STORAGE_SERVICE_URL=http://openroute-storage:8000  # openroute-storage в приватной сети openroute-storage-api-net
STORAGE_TIMEOUT_SECONDS=10                      # таймаут HTTP-вызова storage-service, сек
PROXIES_URL=http://openroute-px6:8000/proxies  # openroute-px6 в приватной сети openroute-px6-net
PX6_SERVICE_URL=http://openroute-px6:8000       # база px6-service для баланса/стран/цены/покупки (API-ключ знает только px6-service)
PROXY_REFRESH_SECONDS=300                       # период перечитывания списка прокси
PROXY_RETRY_SECONDS=10                          # ретрай после неудачного фетча прокси

OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1   # chat/completions апстрим (free-tier)
OPENCODE_MODELS_URL=https://opencode.ai/inference/v1/models # каталог моделей (health-probe прокси)
OPENCODE_MODEL=deepseek-v4.1-flash-free                     # модель по умолчанию (free-tier)
OPENROUTE_RPM_LIMIT=0                           # локальный кап запросов/мин на прокси (0 = выключен; free-tier лимитируется по IP/суткам, не по RPM)

# --- sticky-сессии (session affinity) и дневная квота exit IP ---
AFFINITY_ENABLED=true                           # привязка сессии к exit IP (x-opencode-session/...); false = прежний round-robin без session_affinity
AFFINITY_WINDOW_SECONDS=3600                    # окно статистики сессии R/T, сек
AFFINITY_WEIGHT_SESSIONS=1.0                    # вес S (число привязанных сессий) в score группы
AFFINITY_WEIGHT_REQUESTS=1.0                    # вес R (запросов сессии за окно) в score группы
AFFINITY_WEIGHT_TOKENS=1.0                      # вес T (реальных токенов за окно) в score группы
QUOTA_RESET_MARGIN_SECONDS=60                   # запас после 00:00 UTC перед снятием парковки группы
# 403 abusive traffic навсегда банит exit-бакет (без таймаута и без env-настройки)
PERSONA_ENABLED=true                            # одна persona (session/project/trace) на proxy-bucket; false = не подменять клиентские заголовки

UPSTREAM_TIMEOUT=300                            # общий таймаут апстрима, сек
CONNECT_TIMEOUT=10                              # connect-таймаут отдельно от read, сек

ACCOUNT_FAIL_THRESHOLD=3                        # ошибок в окне до cooldown
ACCOUNT_FAIL_WINDOW_SECONDS=60                   # rolling window ошибок, сек
ACCOUNT_COOLDOWN_SECONDS=60                     # базовый cooldown, сек
ACCOUNT_COOLDOWN_MAX_SECONDS=600                # потолок экспоненциального роста cooldown, сек
ACCOUNT_THROTTLE_THRESHOLD=3                    # подряд 429-кулдаунов до парковки (успех сбрасывает счётчик)
ACCOUNT_THROTTLE_COOLDOWN_SECONDS=3600          # парковка затроттлированного прокси, сек
HEALTH_CHECK_TIMEOUT=8                          # таймаут probe прокси, сек
RETRY_BUDGET_SECONDS=90                         # общий бюджет ретраев на запрос, сек
RETRY_BACKOFF_BASE_SECONDS=0.5                  # база экспоненциального backoff, сек
MAX_BODY_BYTES=20971520                         # лимит тела запроса (20 МиБ), байт
ALERT_WEBHOOK_URL=                              # webhook алертов (Slack-совместимый {"text": ...}); пусто = выключено
