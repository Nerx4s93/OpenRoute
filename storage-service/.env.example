# Shared secret: the gateway sends it as X-Storage-Token. Empty = fail closed
# (every authenticated endpoint returns 401). Do not commit a real value.
STORAGE_API_TOKEN=

# PostgreSQL DSN. This is the ONLY service that knows it.
POSTGRES_DSN=postgresql://openroute:openroute@postgres:5432/openroute

# Async pool / startup. Startup waits for the first connection and fails
# clearly when PostgreSQL is unreachable.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STARTUP_TIMEOUT_SECONDS=15
DB_APPLICATION_NAME=openroute-storage
