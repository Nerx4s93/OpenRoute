# PostgreSQL DSN. This is the ONLY service that knows it.
# In docker-compose the `postgres` hostname is reachable only on the private
# openroute-storage-db-net network (the gateway is not attached to it).
# The service has no authentication: it is reachable only by the gateway on
# the private openroute-storage-api-net network.
POSTGRES_DSN=postgresql://openroute:openroute@postgres:5432/openroute

# Async pool / startup. Startup waits for the first connection and fails
# clearly when PostgreSQL is unreachable.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=8
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STARTUP_TIMEOUT_SECONDS=15
DB_APPLICATION_NAME=openroute-storage
