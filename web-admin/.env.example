# Пароль входа в админку (форма /login, только пароль); пусто = выключена (404)
ADMIN_PASSWORD=

# TTL сессии админки, сек (12 часов)
ADMIN_SESSION_TTL_SECONDS=43200

# Redis — хранилище сессий (адрес в docker-сети)
REDIS_URL=redis://redis:6379/0

# Адрес шлюза OpenRoute в docker-сети (internal API, /internal/*)
GATEWAY_INTERNAL_URL=http://gateway:8000

# ОБЯЗАТЕЛЬНО тот же секрет, что INTERNAL_API_TOKEN в .env шлюза
INTERNAL_API_TOKEN=

# Таймаут запросов к шлюзу, сек
INTERNAL_TIMEOUT_SECONDS=30
