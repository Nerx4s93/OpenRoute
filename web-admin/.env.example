# Адрес приватного auth-service (openroute-auth-net; без публикации через edge)
AUTH_SERVICE_URL=http://openroute-auth:8000

# Таймаут запросов к auth-service, сек
AUTH_TIMEOUT_SECONDS=5

# Адрес шлюза OpenRoute (openroute-net; internal API, /internal/*)
GATEWAY_INTERNAL_URL=http://gateway:8000

# ОБЯЗАТЕЛЬНО тот же секрет, что INTERNAL_API_TOKEN в .env шлюза
INTERNAL_API_TOKEN=

# Таймаут запросов к шлюзу, сек
INTERNAL_TIMEOUT_SECONDS=30
